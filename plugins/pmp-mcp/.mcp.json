{
  "mcpServers": {
    "pmp-mcp": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-launcher.mjs"],
      "env": {
        "PMP_ENV_FILE": "${PMP_ENV_FILE:-}",
        "PMP_INFRA_MODE": "${PMP_INFRA_MODE:-}",
        "PMP_EVM_PRIVATE_KEY": "${PMP_EVM_PRIVATE_KEY:-}",
        "PMP_STORAGE_DIR": "${PMP_STORAGE_DIR:-}",
        "PMP_OZ_ACCOUNT_CLASS_HASH": "${PMP_OZ_ACCOUNT_CLASS_HASH:-}",
        "PMP_MAX_ORDER_USDC": "${PMP_MAX_ORDER_USDC:-}",
        "PMP_STARKNET_RPC_URL": "${PMP_STARKNET_RPC_URL:-}",
        "PMP_POLYGON_RPC_URL": "${PMP_POLYGON_RPC_URL:-}",
        "PMP_POLYGON_BUNDLER_URL": "${PMP_POLYGON_BUNDLER_URL:-}",
        "PMP_PROVER_URL": "${PMP_PROVER_URL:-}",
        "PMP_INDEXER_URL": "${PMP_INDEXER_URL:-}",
        "PMP_AVNU_PAYMASTER_URL": "${PMP_AVNU_PAYMASTER_URL:-}",
        "PMP_AVNU_PAYMASTER_API_KEY": "${PMP_AVNU_PAYMASTER_API_KEY:-}",
        "PMP_BUILDER_CREDS": "${PMP_BUILDER_CREDS:-}",
        "PMP_ALLOWED_MARKETS": "${PMP_ALLOWED_MARKETS:-}",
        "PMP_ALLOWED_DESTINATIONS": "${PMP_ALLOWED_DESTINATIONS:-}",
        "PMP_MAX_POOL_BALANCE": "${PMP_MAX_POOL_BALANCE:-}",
        "PMP_WALLET_INDEX_FLOOR": "${PMP_WALLET_INDEX_FLOOR:-}",
        "PMP_WALLET_INDEX": "${PMP_WALLET_INDEX:-}",
        "PMP_CIRCLE_PAYMASTER_ENABLED": "${PMP_CIRCLE_PAYMASTER_ENABLED:-}",
        "PMP_OFFMARKET_API_KEY": "${PMP_OFFMARKET_API_KEY:-}",
        "PMP_OFFMARKET_GATEWAY_URL": "${PMP_OFFMARKET_GATEWAY_URL:-}"
      }
    }
  }
}
