# Exclusive profiles: PMP_INFRA_MODE is managed OR local. Mixing fails at startup.
# Identity key + storage stay on this process in both profiles.

PMP_EVM_PRIVATE_KEY=0x…
PMP_STORAGE_DIR=./.pmp-mcp-store
PMP_OZ_ACCOUNT_CLASS_HASH=0x5b4b537eaa2399e3aa99c4e2e0208ebd6c71bc1467938cd52c798c601e43564
PMP_MAX_ORDER_USDC=25
# PMP_ALLOWED_MARKETS=
# PMP_MAX_POOL_BALANCE=1000
# PMP_WALLET_INDEX_FLOOR=

# Generate a filled local file: pmp-mcp init   ·   Validate: pmp-mcp check
# Wire it into an agent: pmp-mcp install --agent claude|codex|cursor|opencode

# --- managed ---
# API key from the website wallet sidebar ("Generate API key"). Shown once; revocable per key.
# It authorizes INFRASTRUCTURE only — it cannot sign a transaction or move funds.
# Default gateway https://offmarket.cx/mcp/ — the override is env selection/testing,
# not a hybrid profile (local service vars remain forbidden).
# Generate a managed file: pmp-mcp init --managed
PMP_INFRA_MODE=managed
PMP_OFFMARKET_API_KEY=
# PMP_OFFMARKET_GATEWAY_URL=https://test.offmarket.se-dev.io/mcp

# --- local (comment the managed block; do not set Offmarket vars) ---
# Zero egress to offmarket.cx / the managed gateway.
# PMP_INFRA_MODE=local
# free public endpoint; replace with a paid RPC for reliability
# PMP_STARKNET_RPC_URL=https://rpc.starknet.lava.build
# PMP_PROVER_URL=https://…
# PMP_INDEXER_URL=https://…
# PMP_AVNU_PAYMASTER_API_KEY=
# PMP_POLYGON_BUNDLER_URL=https://…   # required when PMP_CIRCLE_PAYMASTER_ENABLED=true
# free public endpoint; replace with a paid RPC for reliability
# PMP_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# PMP_BUILDER_CREDS={"key":"…","secret":"…","passphrase":"…"}
# PMP_AVNU_PAYMASTER_URL=https://…
